# SMART EDGE API — copy to .env and fill values
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:3000
MONGODB_URI=mongodb://127.0.0.1:27017/smart-edge
# Use a replica set for multi-document transactions (Atlas or local rs).
# Example Atlas: mongodb+srv://user:pass@cluster/smart-edge?retryWrites=true&w=majority

SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
CSRF_SECRET=change-me-csrf-secret-also-long-random
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

# Money: amounts stored as integer minor units (paisa). 100 paisa = 1 PKR
DEFAULT_CURRENCY=PKR
DEFAULT_COUNTRY=PK
STORE_NAME=SMART EDGE

# Local uploads (dev). Production: STORAGE_DRIVER=cloudinary
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
PUBLIC_API_URL=http://localhost:4000

# Cloudinary (required when STORAGE_DRIVER=cloudinary)
CLOUDINARY_URL=
# Or instead of CLOUDINARY_URL:
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Email: "preview" writes to server/mail-preview; configure SMTP for production
EMAIL_DRIVER=preview
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="SMART EDGE <noreply@localhost>"

# Reservation hold duration (minutes) during checkout
CART_RESERVATION_MINUTES=20
LOW_STOCK_THRESHOLD=5

# Rate limits
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=20
CHECKOUT_RATE_LIMIT_MAX=30
